# ── Public chat ─────────────────────────────────────────────────────────
# Anthropic API key used by the server-side /api/chat endpoint (and the admin
# health check). Never prefix it with NEXT_PUBLIC_ — it must stay on the server.
ANTHROPIC_API_KEY=

# ── Admin control center (/admin) ───────────────────────────────────────
# Postgres connection string (Neon, Supabase, Vercel Postgres…). Tables are
# created automatically on first use. Without it the public site still works
# and /admin shows setup instructions.
DATABASE_URL=

# One-time secret (24+ random characters) used to create the first Owner at
# /admin/setup. Safe to delete after the owner account exists.
ADMIN_SETUP_TOKEN=

# Optional: enables the daily scheduled job (health checks, alerts, data
# retention) declared in vercel.json. Vercel sends it as a Bearer token.
# CRON_SECRET=

# ── Optional ────────────────────────────────────────────────────────────
# Default model when no admin override is saved (Settings → AI model).
# CELESTIA_MODEL=claude-opus-5-5

# Default requests per visitor IP per minute (Settings can override).
# CELESTIA_RATE_LIMIT_PER_MINUTE=12

# Public link to the WEB-CREATORS portfolio. Until it is set, the
# "View Portfolio" button shows a "coming soon" placeholder.
# NEXT_PUBLIC_PORTFOLIO_URL=https://example.com/portfolio

# Tests only: a disposable Postgres database (it is wiped by the tests).
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/celestia_test

# ── SEO (optional) ──────────────────────────────────────────────────────
# Public address used in sitemap.xml, robots.txt and canonical links. On Vercel
# it defaults to the production domain automatically (your custom domain once added).
# NEXT_PUBLIC_SITE_URL=https://webcreators.uz
# Google Search Console "HTML tag" verification code (only if you don't verify via DNS).
# GOOGLE_SITE_VERIFICATION=
