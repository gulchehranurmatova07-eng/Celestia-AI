# ── Required ───────────────────────────────────────────────────────────
# Anthropic API key used by the server-side /api/chat endpoint.
# Never prefix it with NEXT_PUBLIC_ — it must stay on the server.
ANTHROPIC_API_KEY=

# ── Optional ───────────────────────────────────────────────────────────
# Claude model (defaults to claude-opus-5-5).
# CELESTIA_MODEL=claude-opus-5-5

# Requests allowed per visitor IP per minute (defaults to 12).
# CELESTIA_RATE_LIMIT_PER_MINUTE=12

# Public link to the WEB-CREATORS portfolio. Until it is set, the
# "View Portfolio" button shows a "coming soon" placeholder.
# NEXT_PUBLIC_PORTFOLIO_URL=https://example.com/portfolio
